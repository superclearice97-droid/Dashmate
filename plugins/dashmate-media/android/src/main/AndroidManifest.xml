<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Phone pairing: the paired phone keeps sending GPS to the screen with its own
         screen off, as a location foreground service with a visible notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets DashMate see the names of these music apps for the media card. -->
    <queries>
        <package android:name="com.spotify.music" />
        <package android:name="com.apple.android.music" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.amazon.mp3" />
        <package android:name="com.pandora.android" />
        <package android:name="deezer.android.app" />
        <package android:name="com.aspiro.tidal" />
        <package android:name="com.soundcloud.android" />
        <package android:name="com.google.android.youtube" />
        <package android:name="au.com.shiftyjelly.pocketcasts" />
    </queries>
    <application>
        <!-- Android only lets apps control other apps' music if the user turns on
             "notification access" for them. DashMate never reads notifications. -->
        <service
            android:name="io.github.superclearice97.dashmate.media.MediaListener"
            android:label="DashMate music controls"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name="io.github.superclearice97.dashmate.media.BeaconService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
